{
  "url": "https://apextest.jasolar.com/ords/uatapex23/f?p=138:133",
  "label": "p133-file-browser-functional",
  "skip_builder_login": true,
  "steps": [
    {
      "action": "click",
      "selector": ".switch-qrcode"
    },
    {
      "action": "fill",
      "selector": "#P9999_USERNAME",
      "value": "{apex_builder_username}"
    },
    {
      "action": "fill",
      "selector": "#P9999_PASSWORD",
      "value": "{apex_builder_password}"
    },
    {
      "action": "apex_submit",
      "request": "LOGIN"
    },
    {
      "action": "wait_for_selector",
      "selector": "#p133_pathbar"
    },
    {
      "action": "click",
      "selector": ".p133-view-btn[data-view-mode='grid']"
    },
    {
      "action": "wait_for_selector",
      "selector": "#p133_grid_view"
    },
    {
      "action": "click",
      "selector": ".p133-view-btn[data-view-mode='list']"
    },
    {
      "action": "wait_for_selector",
      "selector": ".p133-crumb"
    },
    {
      "action": "click",
      "selector": ".p133-crumb"
    },
    {
      "action": "wait_for_selector",
      "selector": "#content_ig"
    }
  ],
  "assertions": [
    {
      "type": "selector_visible",
      "selector": ".sts-tenant-switcher"
    },
    {
      "type": "selector_visible",
      "selector": "#stsTenantSelect"
    },
    {
      "type": "selector_visible",
      "selector": ".p133-crumb"
    },
    {
      "type": "text_visible",
      "text": "名称"
    }
  ]
}
